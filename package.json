{
  "name": "lantern-post",
  "version": "0.0.0",
  "private": true,
  "workspaces": ["client", "server", "packages/*"],
  "engines": { "node": ">=24.3.0 <25", "npm": ">=10" },
  "scripts": {
    "check:beta-ui": "node scripts/check-phase10-ui.mjs --phase11",
    "check:cabinet-ui": "node scripts/check-phase10-ui.mjs --cabinet",
    "check:social-ui": "node scripts/check-phase10-ui.mjs --social",
    "check:privacy-ui": "node scripts/check-phase10-ui.mjs --privacy",
    "check:unreviewed-ui": "node scripts/check-phase10-ui.mjs --unreviewed",
    "check:voice-backup-ui": "node scripts/check-phase10-ui.mjs --voice-backup",
    "check:live-palace-ui": "node scripts/check-phase10-ui.mjs --live",
    "check:mobile-ui": "node scripts/check-phase10-ui.mjs --mobile",
    "check:friend-gates-ui": "node scripts/check-phase10-ui.mjs --mobile --friend-gates",
    "check:guidance-ui": "node scripts/check-phase10-ui.mjs --guidance",
    "check:palace-ux-ui": "node scripts/check-palace-refinements-ui.mjs",
    "check:palace-ux-web": "node scripts/check-palace-refinements-ui.mjs --web",
    "check:session-ui": "node scripts/check-phase10-ui.mjs --session",
    "check:bell-ui": "node scripts/check-phase10-ui.mjs --bell",
    "check:chat-speed-ui": "node scripts/check-phase10-ui.mjs --chat-speed",
    "check:mobile-build": "node scripts/check-mobile-build.mjs",
    "check:native-google": "node scripts/check-native-google.mjs",
    "build:hosted-api": "node scripts/build-hosted-api.mjs",
    "check:hosted-api": "node scripts/check-hosted-api.mjs",
    "test:hosted-api": "node --test scripts/hosted-api.test.mjs",
    "api:hosted": "node scripts/configure-api.mjs hosted",
    "api:local": "node scripts/configure-api.mjs local",
    "test:api-settings": "node --test scripts/configure-api.test.mjs",
    "setup:drive": "node scripts/setup-drive.mjs",
    "check:drive-config": "node scripts/setup-drive.mjs --check",
    "test:drive-setup": "node --test scripts/setup-drive.test.mjs",
    "setup:expo-project": "node scripts/link-expo-project.mjs",
    "test:mobile-config": "node --test scripts/mobile-build.test.mjs",
    "dev:android": "npm run android --workspace @lantern-post/mobile --",
    "load:infinity": "node scripts/load-test-infinity.mjs",
    "load:infinity:db": "node server/scripts/load-infinity-database.mjs",
    "prepare:policies": "node scripts/prepare-policy-documents.mjs",
    "check:release": "node scripts/check-release.mjs",
    "setup:push": "node scripts/setup-native-push.mjs",
    "setup:voice-storage": "node server/scripts/setup-voice-storage.mjs",
    "start": "npm run start --workspace @lantern-post/mobile --",
    "setup:env": "node scripts/setup-env.mjs",
    "dev:mobile": "npm run start --workspace @lantern-post/mobile --",
    "dev:web": "npm run web --workspace @lantern-post/mobile --",
    "dev:server": "npm run start:dev --workspace @lantern-post/api --",
    "dev:api": "npm run start:dev --workspace @lantern-post/api --",
    "start:api": "npm run start --workspace @lantern-post/api",
    "db:local:up": "npm run db:local:up --workspace @lantern-post/api",
    "db:local:down": "npm run db:local:down --workspace @lantern-post/api",
    "db:generate": "npm run prisma:generate --workspace @lantern-post/api",
    "db:validate": "npm run prisma:validate --workspace @lantern-post/api",
    "db:migrate": "npm run prisma:migrate --workspace @lantern-post/api --",
    "db:deploy": "npm run prisma:deploy --workspace @lantern-post/api",
    "db:status": "npm run prisma:status --workspace @lantern-post/api",
    "db:studio": "npm run prisma:studio --workspace @lantern-post/api",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build:api": "npm run build --workspace @lantern-post/api",
    "smoke:api": "npm run smoke --workspace @lantern-post/api",
    "export:mobile": "npm run export --workspace @lantern-post/mobile --",
    "export:web": "npm run export --workspace @lantern-post/mobile -- --platform web"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.59.0"
  }
}

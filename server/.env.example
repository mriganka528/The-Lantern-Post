NODE_ENV=development
PORT=3000
MODERATION_MODE=disabled
# disabled: send normally without automated content review (current release).
# required: reserve for a future configured provider; unavailable checks stop sends.

# All database and backend settings live in server/.env.
# Paste the Neon connection URL for the selected project/branch.
DATABASE_URL=
# Optional: unpooled URL for the SAME endpoint, database, and schema.
DIRECT_URL=
# Only needed to author migrations: a SEPARATE disposable database/branch.
SHADOW_DATABASE_URL=

# Exact browser origins, trusted for CORS and Clerk web session tokens.
# Production browser origins must use HTTPS.
# Hosted Android WebSockets also send the API's own HTTPS origin; add that exact
# public origin here after configuring the host's public port/domain.
WEB_ORIGINS=http://localhost:8081,http://127.0.0.1:8081

# Clerk Dashboard > API keys, from the SAME development/production instance.
# The issuer is derived from the publishable key; Clerk fetches signing keys.
CLERK_PUBLISHABLE_KEY=
# Server only. Never copy this into client/.env or an EXPO_PUBLIC_* variable.
CLERK_SECRET_KEY=
# Optional additional exact azp values beyond WEB_ORIGINS.
# Native tokens may omit azp; other values are rejected.
CLERK_AUTHORIZED_PARTIES=

# Enable after configuring an Expo development/production build for push.
EXPO_PUSH_ENABLED=false
# Optional Expo enhanced push-security credential; server only.
EXPO_ACCESS_TOKEN=

# Recommended no-card setup: a Supabase Free project, used only for private voice files.
# Project Settings > API keys > Legacy keys > service_role (SERVER ONLY).
SUPABASE_URL=
SUPABASE_VOICE_BUCKET=
SUPABASE_SERVICE_ROLE_KEY=
# Conservative 256 MiB total app reservation, including incoming/sealed copies.
VOICE_STORAGE_BUDGET_BYTES=268435456
# After setting the three Supabase values, run npm.cmd run setup:voice-storage.
# Keep the legacy S3 values empty when using Supabase.

# Optional legacy S3-compatible voice storage. Choose only one provider.
# R2: endpoint https://ACCOUNT.r2.cloudflarestorage.com and region auto.
# S3: endpoint https://s3.REGION.amazonaws.com and the matching AWS region.
VOICE_STORAGE_ENDPOINT=
VOICE_STORAGE_BUCKET=
VOICE_STORAGE_REGION=
VOICE_STORAGE_ACCESS_KEY_ID=
VOICE_STORAGE_SECRET_ACCESS_KEY=

# Optional: forward only consented, fixed error codes. No messages/stacks/content.
DIAGNOSTICS_SENTRY_DSN=

# Optional local PostgreSQL container; not needed with Neon.
POSTGRES_USER=lantern-post
POSTGRES_PASSWORD=lantern-post_dev
POSTGRES_DB=lantern-post
POSTGRES_PORT=5432
# Optional direct Google Drive chat backups. Configure all four together.
# OAuth client type: Web application. Enable Google Drive API and drive.appdata.
# Register this exact redirect URI; use your public HTTPS API for phones/production.
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_DRIVE_REDIRECT_URI=
# A stable, secret, base64-encoded 32-byte key for server-side OAuth tokens.
# This is separate from each user's locally generated backup recovery key.
GOOGLE_DRIVE_TOKEN_KEY=

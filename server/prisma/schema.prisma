// schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum LetterType {
  TEXT
  VOICE
}

enum LetterDestinationType {
  INFINITY
  FRIEND
  BURNING
}

enum LetterStatus {
  DRAFT
  SENDING
  DELIVERED
  SOFT_DELETED   // burned messages after animation, or reported+removed
  HARD_DELETED   // retained only as an audit stub, content purged
}

enum BurnOutcome {
  BURNED
  REJECTED
}

enum DeliveryOutcome {
  DELIVERED
  REJECTED
}

enum VoiceAssetStatus {
  UPLOADING
  READY
  ATTACHED
  DELETED
}

enum FriendRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
  BLOCKED
}

enum ReportReason {
  HARASSMENT
  SPAM
  HATE_SPEECH
  SELF_HARM_CONCERN
  OTHER
}

enum ReportStatus {
  OPEN
  REVIEWED
  ACTIONED
  DISMISSED
}

model User {
  id            String   @id @default(cuid())
  username      String   @unique
  authProviderId String  @unique   // id from Supabase Auth / Clerk / etc.
  characterId   String?
  character     Character? @relation(fields: [characterId], references: [id])
  palaceTheme   String?    // simple config key for MVP; expand to a Palace model post-MVP
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  diagnosticsEnabled Boolean @default(false)
  diagnosticsKey String? @unique
  diagnosticsSince DateTime?
  accountState String @default("ACTIVE")
  realtimeSequence Int @default(0)
  palaceEvents PalaceEvent[]
  accountDeletion AccountDeletion?
  driveConnection DriveConnection?
  driveLinks DriveLink[]

  sentLetters       Letter[]           @relation("SentLetters")
  receivedLetters   Letter[]           @relation("ReceivedLetters")
  friendRequestsSent     FriendRequest[] @relation("RequestsSent")
  friendRequestsReceived FriendRequest[] @relation("RequestsReceived")
  reportsFiled      Report[]           @relation("ReportsFiled")
  reportsAgainst    Report[]           @relation("ReportsAgainst")
  blockedUsers      Block[]            @relation("Blocker")
  blockedByUsers    Block[]            @relation("Blocked")
  pushTokens        PushToken[]
  burnReceipts      BurnReceipt[]
  friendNotifications FriendNotification[]
  deliveryReceipts DeliveryReceipt[]
  worldReceipts WorldReceipt[]
  voiceAssets VoiceAsset[]
  firstChatThreads ChatThread[] @relation("FirstChatUser")
  secondChatThreads ChatThread[] @relation("SecondChatUser")
  chatMessages ChatMessage[]
  chatReceipts ChatReceipt[]
  chatReports ChatReport[]

  @@index([username])
}

model Character {
  id          String  @id @default(cuid())
  key         String  @unique   // e.g. "fox-lantern", "owl-scholar"
  displayName String
  assetUrl    String            // CDN URL to sprite/animation bundle
  isActive    Boolean @default(true)  // curated set can be toggled without deleting history
  users       User[]
}

model ChatThread {
  id String @id
  firstUserId String
  firstUser User @relation("FirstChatUser", fields: [firstUserId], references: [id])
  secondUserId String
  secondUser User @relation("SecondChatUser", fields: [secondUserId], references: [id])
  nextSequence Int @default(0)
  createdAt DateTime @default(now())
  messages ChatMessage[]
  @@unique([firstUserId, secondUserId])
}

model ChatMessage {
  id String @id
  threadId String
  thread ChatThread @relation(fields: [threadId], references: [id])
  sequence Int
  senderId String
  sender User @relation(fields: [senderId], references: [id])
  text String
  moderationPassed Boolean?
  moderationSkipped Boolean @default(false)
  erasedAt DateTime?
  createdAt DateTime @default(now())
  reports ChatReport[]
  @@unique([threadId, sequence])
}

// Content-free, durable outcomes for explicitly confirmed chat sends/cancels.
model ChatReceipt {
  id String @id
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])
  peerId String
  outcome DeliveryOutcome
  reason String?
  messageId String? @unique
  sequence Int?
  createdAt DateTime @default(now())
  @@index([ownerId, createdAt])
}

model ChatReport {
  id String @id
  messageId String
  message ChatMessage @relation(fields: [messageId], references: [id])
  reporterId String
  reporter User @relation(fields: [reporterId], references: [id])
  reason ReportReason
  detail String?
  status ReportStatus @default(OPEN)
  createdAt DateTime @default(now())
  @@unique([messageId, reporterId])
  @@index([status, createdAt])
}

model Preset {
  id          String  @id @default(cuid())
  key         String  @unique
  displayName String
  configJson  Json     // paper texture, seal color, border, font — data-driven
  isSeasonal  Boolean  @default(false)
  isActive    Boolean  @default(true)
  letters     Letter[]
}

// Only an operation outcome is kept here; never letter text or a text digest.
// A durable rejection prevents a delayed duplicate from burning a letter that
// the app was already told it could edit again.
model BurnReceipt {
  id          String @id
  ownerId     String
  owner       User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  outcome     BurnOutcome
  reason      String?
  letterId    String? @unique
  createdAt   DateTime @default(now())

  @@index([ownerId])
}

model DeliveryReceipt {
  id          String @id
  ownerId     String
  owner       User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  recipientId String
  outcome     DeliveryOutcome
  reason      String?
  letterId    String? @unique
  createdAt   DateTime @default(now())

  @@index([ownerId])
}

model Letter {
  id              String   @id @default(cuid())
  senderId        String
  sender          User     @relation("SentLetters", fields: [senderId], references: [id])
  recipientId     String?           // only set for FRIEND destination
  recipient       User?    @relation("ReceivedLetters", fields: [recipientId], references: [id])

  type            LetterType
  destinationType LetterDestinationType
  textContent     String?           // for TEXT type
  audioUrl        String?           // legacy; current voice letters use private VoiceAsset and fresh playback grants
  audioDurationMs Int?
  voiceCaption    String?
  voiceAssetId    String? @unique
  voiceAsset      VoiceAsset? @relation(fields: [voiceAssetId], references: [id])

  presetId        String?
  preset          Preset?  @relation(fields: [presetId], references: [id])

  isSigned        Boolean  @default(false)   // "Sign it" — reveal sender username publicly
  posX            Float?             // Infinity World coordinate
  posY            Float?             // Infinity World coordinate

  status          LetterStatus @default(SENDING)
  moderationPassed Boolean?          // null = pending or explicitly skipped, true/false = result
  moderationSkipped Boolean @default(false) // explicit unreviewed release, never provider approval
  moderationCheckedAt DateTime?
  stationeryJson  Json?              // snapshot of the validated stationery at delivery
  readAt          DateTime?          // first opening by the recipient
  senderDeletedAt DateTime?
  recipientDeletedAt DateTime?

  createdAt       DateTime @default(now())
  deliveredAt     DateTime?
  softDeletedAt   DateTime?
  hardDeleteAfter DateTime?          // scheduled purge time for BURNING/removed content

  reports         Report[]
  notifications   FriendNotification[]

  @@index([destinationType, posX, posY])   // Infinity World bounding-box queries
  @@index([recipientId, status])           // friend gate inbox queries
  @@index([hardDeleteAfter])               // sweep job
  @@index([senderId, destinationType, status, deliveredAt])
  @@index([destinationType, status, moderationPassed, posX, posY], map: "Letter_infinity_viewport_idx")
}

model VoiceAsset {
  id          String @id
  ownerId     String
  owner       User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  recipientId String?
  destinationType LetterDestinationType @default(FRIEND)
  requestId   String
  storageKey  String @unique
  mimeType    String
  byteLength  Int
  durationMs  Int
  sha256      String?
  status      VoiceAssetStatus @default(UPLOADING)
  createdAt   DateTime @default(now())
  expiresAt   DateTime
  purgeAfter  DateTime?
  stageClearedAt DateTime?
  contentClearedAt DateTime?
  letter      Letter?

  @@unique([ownerId, requestId])
  @@index([status, purgeAfter])
  @@index([ownerId, status, expiresAt])
}

model FriendRequest {
  id          String   @id @default(cuid())
  fromUserId  String
  fromUser    User     @relation("RequestsSent", fields: [fromUserId], references: [id])
  toUserId    String
  toUser      User     @relation("RequestsReceived", fields: [toUserId], references: [id])
  status      FriendRequestStatus @default(PENDING)
  createdAt   DateTime @default(now())
  respondedAt DateTime?
  notifications FriendNotification[]

  @@unique([fromUserId, toUserId])
  // SQL also enforces one row per unordered pair, and disallows self-requests.
  @@index([toUserId, status, createdAt])
  @@index([fromUserId, status, createdAt])
}

// A durable, content-free outbox. A friendship can succeed while push is down.
model FriendNotification {
  id          String @id
  userId      String
  user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
  requestId   String?
  request     FriendRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  letterId    String?
  chatMessageId String?
  letter      Letter? @relation(fields: [letterId], references: [id], onDelete: Cascade)
  kind        String // FRIEND_REQUEST | FRIEND_ACCEPTED | LETTER_DELIVERED | CHAT_MESSAGE; checked in SQL
  createdAt   DateTime @default(now())
  availableAt DateTime @default(now())
  claimedUntil DateTime?
  attempts    Int @default(0)
  completedAt DateTime?

  @@index([completedAt, availableAt])
}

// Account-private, content-free refresh/arrival events. Sequence allocation is
// committed with the mutation, so a later event cannot slip behind a cursor.
model PalaceEvent {
  id String @id
  ownerId String
  owner User @relation(fields:[ownerId], references:[id], onDelete:Cascade)
  sequence Int
  kind String
  peerId String?
  itemId String?
  createdAt DateTime @default(now())
  @@unique([ownerId,sequence])
  @@index([createdAt])
}

model Block {
  id          String   @id @default(cuid())
  blockerId   String
  blocker     User     @relation("Blocker", fields: [blockerId], references: [id])
  blockedId   String
  blocked     User     @relation("Blocked", fields: [blockedId], references: [id])
  createdAt   DateTime @default(now())
  anonymousAlias String? @unique

  @@unique([blockerId, blockedId])
}

model Report {
  id          String   @id @default(cuid())
  letterId    String
  letter      Letter   @relation(fields: [letterId], references: [id])
  reporterId  String
  reporter    User     @relation("ReportsFiled", fields: [reporterId], references: [id])
  reportedUserId String
  reportedUser   User  @relation("ReportsAgainst", fields: [reportedUserId], references: [id])
  reason      ReportReason
  detail      String?
  status      ReportStatus @default(OPEN)
  createdAt   DateTime @default(now())
  resolvedAt  DateTime?

  @@unique([reporterId, letterId])
  @@index([status, createdAt])
}

// Short-lived, shared request budgets. The key hashes the verified subject,
// operation scope and time bucket; no tokens, IPs or letter content are stored.
model RequestWindow {
  id        String @id
  count     Int
  expiresAt DateTime

  @@index([expiresAt])
}

model WorldReceipt {
  id        String @id
  ownerId   String
  owner     User @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  outcome   DeliveryOutcome
  isSigned  Boolean
  reason    String?
  letterId  String? @unique
  createdAt DateTime @default(now())

  @@index([ownerId, createdAt])
}

model PushToken {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  token     String   @unique
  platform  String   // "ios" | "android"
  createdAt DateTime @default(now())

  @@index([userId])
}

model DiagnosticsEvent {
  id            String @id
  actorKey      String
  name          String
  platform      String
  code          String?
  occurredAt    DateTime
  createdAt     DateTime @default(now())
  exportedAt    DateTime?
  attempts      Int @default(0)
  availableAt   DateTime @default(now())

  @@index([actorKey, occurredAt])
  @@index([exportedAt, availableAt])
}

// Durable, content-free deletion status and external-cleanup outbox.
model AccountDeletion {
  id String @id
  ownerId String @unique
  owner User @relation(fields: [ownerId], references: [id])
  subjectHash String @unique
  providerSubject String?
  diagnosticsKey String?
  state String @default("PENDING")
  requestedAt DateTime @default(now())
  completedAt DateTime?
  availableAt DateTime @default(now())
  claimedUntil DateTime?
  attempts Int @default(0)
  errorCode String?
  @@index([state, availableAt])
}

model DriveConnection {
  ownerId String @id
  owner User @relation(fields: [ownerId], references: [id])
  encryptedRefreshToken String
  connectedAt DateTime @default(now())
  activeUntil DateTime?
}

model DriveLink {
  id String @id
  ownerId String
  owner User @relation(fields: [ownerId], references: [id])
  stateHash String @unique
  encryptedVerifier String?
  encryptedCleanupToken String?
  exchangingUntil DateTime?
  status String @default("PENDING")
  expiresAt DateTime
  createdAt DateTime @default(now())
  @@index([ownerId, expiresAt])
}

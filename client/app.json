{
  "expo": {
    "name": "Lantern Post",
    "slug": "lantern-post",
    "version": "0.1.0",
    "scheme": "lantern-post",
    "icon": "./assets/app-icon/icon.png",
    "splash": {
      "backgroundColor": "#F8F4EA"
    },
    "android": {
      "package": "com.lanternpost.app",
      "googleServicesFile": "./google-services.json",
      "allowBackup": false,
      "softwareKeyboardLayoutMode": "resize",
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/app-icon/adaptive-foreground.png",
        "backgroundImage": "./assets/app-icon/adaptive-background.png",
        "monochromeImage": "./assets/app-icon/monochrome.png",
        "backgroundColor": "#171829"
      }
    },
    "ios": {
      "bundleIdentifier": "com.lanternpost.app",
      "supportsTablet": false
    },
    "platforms": [
      "ios",
      "android",
      "web"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/app-icon/favicon.png"
    },
    "orientation": "portrait",
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Lantern Post to record a voice letter when you choose Record.",
          "enableBackgroundRecording": false,
          "enableBackgroundPlayback": false
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/app-icon/notification.png",
          "color": "#C4A777"
        }
      ],
      "@clerk/expo-google-signin",
      "@react-native-google-signin/google-signin",
      "./plugins/with-light-theme"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "mobile": {
        "androidPushConfigured": false
      },
      "router": {},
      "eas": {
        "projectId": "517cfd4f-9586-411f-85c5-f457ecb577e4"
      }
    },
    "owner": "mriganka528"
  }
}

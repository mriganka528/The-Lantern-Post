{
  "name": "@lantern-post/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start --port 8081",
    "web": "expo start --web --port 8081",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "export": "expo export",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",

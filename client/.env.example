# Public value: included in the app bundle. Never put secrets in EXPO_PUBLIC_*.
# Default backend for installed apps and development. A local API is optional.
EXPO_PUBLIC_API_URL=https://the-lantern-post.onrender.com

# The browser also uses Render; running a local backend is not required.
EXPO_PUBLIC_WEB_API_URL=https://the-lantern-post.onrender.com

# Clerk Dashboard > API keys > Publishable key (pk_test_... for development).
# Never put a Clerk secret key in an EXPO_PUBLIC_* variable.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Native Android Google login: the public OAuth WEB client ID configured in
# Clerk's Google connection. This is not an Android client ID or client secret.
# Register the APK package/signing SHA-1 in that Google Cloud project as well.
EXPO_PUBLIC_CLERK_GOOGLE_WEB_CLIENT_ID=

# Public EAS project UUID, only needed for optional native push notifications.
EXPO_PUBLIC_EAS_PROJECT_ID=

# Public value: included in the app bundle. Never put secrets in EXPO_PUBLIC_*.
# Android emulator: http://10.0.2.2:3000
# iOS simulator (macOS): http://localhost:3000
# Physical device: http://YOUR_COMPUTER_LAN_IP:3000 (same Wi-Fi)
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000

# Browser preview uses this URL independently of the Android emulator address.
EXPO_PUBLIC_WEB_API_URL=http://localhost:3000

# Clerk Dashboard > API keys > Publishable key (pk_test_... for development).
# Never put a Clerk secret key in an EXPO_PUBLIC_* variable.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Public EAS project UUID, only needed for optional native push notifications.
EXPO_PUBLIC_EAS_PROJECT_ID=
